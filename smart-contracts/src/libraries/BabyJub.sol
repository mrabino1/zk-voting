pragma solidity 0.8.24;

// NOT FOR PROFIT — civic public good, not a commercial product.

/// @title BabyJub
/// @notice Baby Jubjub, the twisted Edwards curve over the BN254 scalar field.
/// @dev Ballot ciphertexts, the joint key and guardian shares live on this curve, so a
///      circuit checks them with native field arithmetic. There is no precompile: points
///      are added in projective coordinates with one Fermat inversion at the end.
///      The identity is `(0, 1)`. An empty ElGamal sum is `((0, 1), (0, 1))`.
library BabyJub {
    /// @notice Base field (the BN254 scalar field).
    uint256 internal constant P = 21888242871839275222246405745257275088548364400416034343698204186575808495617;
    /// @notice Order of the prime subgroup generated by `G`.
    uint256 internal constant ORDER = 2736030358979909402780800718157159386076813972158567259200215660948447373041;
    uint256 internal constant A = 168700;
    uint256 internal constant D = 168696;
    /// @notice Generator `Base8` of the prime subgroup.
    uint256 internal constant GX = 5299619240641551281634865583518297030282874472190772894086521144482721001553;
    uint256 internal constant GY = 16950150798460657717958625567821834550301663161624707787222815936182638968203;

    /// @notice `a x² + y² = 1 + d x² y²`, with both coordinates reduced.
    function onCurve(uint256 x, uint256 y) internal pure returns (bool) {
        if (x >= P || y >= P) return false;
        uint256 x2 = mulmod(x, x, P);
        uint256 y2 = mulmod(y, y, P);
        uint256 lhs = addmod(mulmod(A, x2, P), y2, P);
        uint256 rhs = addmod(1, mulmod(mulmod(D, x2, P), y2, P), P);
        return lhs == rhs;
    }

    /// @notice On the curve and in the prime-order subgroup (`ORDER · p = identity`), so not
    ///         the identity and not a small-torsion point. Use it for keys and commitments.
    function inSubgroup(uint256 x, uint256 y) internal pure returns (bool) {
        if (!onCurve(x, y) || (x == 0 && y == 1)) return false;
        (uint256 ox, uint256 oy) = _mulRaw(x, y, ORDER);
        return ox == 0 && oy == 1;
    }

    function isIdentity(uint256 x, uint256 y) internal pure returns (bool) {
        return x == 0 && y == 1;
    }

    function neg(uint256 x, uint256 y) internal pure returns (uint256, uint256) {
        return (x == 0 ? 0 : P - x, y);
    }

    function add(uint256 x1, uint256 y1, uint256 x2, uint256 y2) internal pure returns (uint256, uint256) {
        (uint256 X, uint256 Y, uint256 Z) = _addProj(x1, y1, 1, x2, y2, 1);
        return _affine(X, Y, Z);
    }

    function sub(uint256 x1, uint256 y1, uint256 x2, uint256 y2) internal pure returns (uint256, uint256) {
        (uint256 nx, uint256 ny) = neg(x2, y2);
        return add(x1, y1, nx, ny);
    }

    /// @notice `s · G`. Zero gives the identity.
    function mulBase(uint256 s) internal pure returns (uint256, uint256) {
        return mul(GX, GY, s);
    }

    /// @notice `s · p` for `p` in the prime subgroup. The scalar is reduced mod `ORDER`.
    function mul(uint256 x, uint256 y, uint256 s) internal pure returns (uint256, uint256) {
        return _mulRaw(x, y, s % ORDER);
    }

    function _mulRaw(uint256 x, uint256 y, uint256 k) private pure returns (uint256, uint256) {
        uint256 X;
        uint256 Y = 1;
        uint256 Z = 1;
        uint256 BX = x;
        uint256 BY = y;
        uint256 BZ = 1;
        while (k > 0) {
            if (k & 1 == 1) (X, Y, Z) = _addProj(X, Y, Z, BX, BY, BZ);
            (BX, BY, BZ) = _dblProj(BX, BY, BZ);
            k >>= 1;
        }
        return _affine(X, Y, Z);
    }

    /// @dev Projective twisted-Edwards addition. `(X:Y:Z)` is the affine point `(X/Z, Y/Z)`.
    function _addProj(uint256 X1, uint256 Y1, uint256 Z1, uint256 X2, uint256 Y2, uint256 Z2)
        private
        pure
        returns (uint256 X3, uint256 Y3, uint256 Z3)
    {
        uint256 a = mulmod(Z1, Z2, P);
        uint256 b = mulmod(a, a, P);
        uint256 c = mulmod(X1, X2, P);
        uint256 d = mulmod(Y1, Y2, P);
        uint256 e = mulmod(mulmod(D, c, P), d, P);
        uint256 f = addmod(b, P - e, P);
        uint256 g = addmod(b, e, P);
        uint256 mixed = addmod(mulmod(addmod(X1, Y1, P), addmod(X2, Y2, P), P), P - addmod(c, d, P), P);
        X3 = mulmod(mulmod(a, f, P), mixed, P);
        Y3 = mulmod(mulmod(a, g, P), addmod(d, P - mulmod(A, c, P), P), P);
        Z3 = mulmod(f, g, P);
    }

    function _dblProj(uint256 X1, uint256 Y1, uint256 Z1) private pure returns (uint256 X3, uint256 Y3, uint256 Z3) {
        uint256 sum = addmod(X1, Y1, P);
        uint256 b = mulmod(sum, sum, P);
        uint256 c = mulmod(X1, X1, P);
        uint256 d = mulmod(Y1, Y1, P);
        uint256 e = mulmod(A, c, P);
        uint256 f = addmod(e, d, P);
        uint256 h = mulmod(Z1, Z1, P);
        uint256 j = addmod(f, P - addmod(h, h, P), P);
        X3 = mulmod(addmod(b, P - addmod(c, d, P), P), j, P);
        Y3 = mulmod(f, addmod(e, P - d, P), P);
        Z3 = mulmod(f, j, P);
    }

    function _affine(uint256 X, uint256 Y, uint256 Z) private pure returns (uint256, uint256) {
        uint256 inv = invMod(Z, P);
        return (mulmod(X, inv, P), mulmod(Y, inv, P));
    }

    /// @notice `a⁻¹ mod m` for prime `m` (Fermat). `a` must be non-zero mod `m`.
    function invMod(uint256 a, uint256 m) internal pure returns (uint256 res) {
        res = 1;
        uint256 base = a % m;
        uint256 exp = m - 2;
        unchecked {
            while (exp > 0) {
                if (exp & 1 == 1) res = mulmod(res, base, m);
                base = mulmod(base, base, m);
                exp >>= 1;
            }
        }
    }
}
