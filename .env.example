# NOT FOR PROFIT — civic public good, not a commercial product.
# Copy to .env (gitignored) and fill in secrets. Compose loads this file
# for interpolation; do not put production keys in git.
#
#   cp .env.example .env
#
# Intentional forks: a jurisdiction runs its own Node (clerk desk + pages)
# and pins the ONE shared ElectionFactory / BallotInbox / verifier.
# Do not run DeployLocal again for a new city. Env wins over the clerk
# CMS at /office/site. Public URLs are /admin not /admin.html.
# See README.md § Intentional forking.

# --- Node (API + SPA) ---
ZK_VOTING_PORT=3000
CHAIN_ID=27427
# Inside Compose the sequencer is reachable as http://l2:8546.
# Leave empty to run the Node without a chain (local JSON store only).
CHAIN_RPC=http://l2:8546
RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_HANDLE=admin
BALLOT_INBOX_ADDRESS=
# Shared ElectionFactory for every forked Node (FACTORY alias). Also
# pin-able in /office/site when this is empty (platform_admin).
# Do not deploy a new factory per city.
ELECTION_FACTORY_ADDRESS=
# Groth16 / MockVerifier from the shared deploy (VERIFIER alias).
# Required with CHAIN_RPC unless the site pin is set.
VERIFIER_ADDRESS=
RELAYER_PRIVATE_KEY=
# 3600 = hourly public vote disclosure. 0 = publish immediately (local demo).
DISCLOSURE_INTERVAL_SECONDS=3600
ALLOW_DEV_LOGIN=
ALLOW_SMART_CARD_MOCK=
ALLOW_CIVIC_ID_MOCK=
# Email MFA + Terms PDF (DealPunchList-shaped). When FROM + REGION are
# set, every non-dev login completes with a 6-digit AWS SES code, and
# accepting /terms emails the current Terms PDF as a raw MIME attachment.
# Tests skip MFA unless REQUIRE_EMAIL_MFA=1; the email-first path always
# uses OTP. Tests capture both OTP and the Terms PDF in-process.
SES_FROM_ADDRESS=
AWS_REGION=
SES_CONFIGURATION_SET=
SES_DRY_RUN=
REQUIRE_EMAIL_MFA=
# HMAC and PDF owner-password material for locked vote-receipt PDFs.
# Unset → the Node writes a random secret to $DATA_DIR/receipt-pdf.secret.
RECEIPT_PDF_SECRET=

# --- Republic L2 ---
L2_RPC_PORT=8546
L2_BATCH_SIZE=4
DEV_MOCK_PROOF=true
REPUBLIC_NODE_URL=http://node:3000

# L1 settlement for the **prover** (optional). When all three are set, the
# prover submits RollupSettlement.submitBatch. Otherwise it writes JSON
# under the l2 volume. PRIVATE_KEY is the L2 prover key, not the Node
# L1_PUBLISHER_PRIVATE_KEY.
L1_RPC=
SETTLEMENT_ADDRESS=
PRIVATE_KEY=

# Node L1 tally-hash certification (optional). Unset → tally still works
# (status skipped). Never put a mainnet publisher key here in CI.
L1_TALLY_MIRROR_ADDRESS=
L1_PUBLISHER_PRIVATE_KEY=
L1_SETTLEMENT_ADDRESS=
L1_CHAIN_ID=
