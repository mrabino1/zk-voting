# NOT FOR PROFIT — civic public good, not a commercial product.
# Copy-paste into .env (gitignored) and fill in secrets. Compose interpolates
# this file; do not put production keys in git.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Full commented block: README.md § Copy-paste credentials.
# Intentional forks pin the ONE shared ElectionFactory / BallotInbox /
# verifier. Do not run DeployLocal again for a new city. Env wins over
# /office/site. Public URLs are /admin not /admin.html.

# --- this host (Node API + SPA) ---
ZK_VOTING_PORT=3000
CHAIN_ID=27427
# Inside Compose the sequencer is reachable as http://l2:8546.
# Leave empty to run the Node without a chain (local JSON store only).
CHAIN_RPC=http://l2:8546
RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origin printed in official-outcome QR codes (defaults to first WEBAUTHN origin).
PUBLIC_BASE_URL=
ADMIN_HANDLE=admin
# 3600 = hourly public vote disclosure. 0 = publish immediately (local demo).
DISCLOSURE_INTERVAL_SECONDS=3600
ALLOW_DEV_LOGIN=
ALLOW_SMART_CARD_MOCK=
ALLOW_CIVIC_ID_MOCK=

# --- AWS SES (email MFA + Terms PDF). Empty = local demo, no outbound mail.
# When FROM + REGION are set, every non-dev login completes with a 6-digit
# AWS SES code, and accepting /terms emails the current Terms PDF.
# Leave AWS keys empty to use the host IAM / instance role.
# Tests skip MFA unless REQUIRE_EMAIL_MFA=1.
SES_FROM_ADDRESS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_ENDPOINT=
SES_DRY_RUN=
REQUIRE_EMAIL_MFA=

# Optional shared secret so a later DMV / AAMVA / eID connector can
# POST /api/integrations/credentials/status. Unset = manual officer review.
CREDENTIAL_PROVIDER_SECRET=
CREDENTIAL_PROVIDER_ID=manual

# HMAC and PDF owner-password material for locked vote-receipt PDFs
# and official outcome PDFs. Unset → the Node writes a random secret to
# $DATA_DIR/receipt-pdf.secret.
RECEIPT_PDF_SECRET=

# Shared secret for L2 sequencer → Node explorer ingest. Unset in
# production refuses ingest (the explorer is not a second tally). Tests
# allow unauthenticated ingest. Set the same value on Node and l2.
EXPLORER_INGEST_SECRET=

# --- pin the ONE shared deploy (FACTORY / VERIFIER aliases). Also pin-able
# in /office/site when these are empty (platform_admin). Required with
# CHAIN_RPC unless the site pin is set. Do not deploy a new factory per city.
ELECTION_FACTORY_ADDRESS=
BALLOT_INBOX_ADDRESS=
VERIFIER_ADDRESS=
RELAYER_PRIVATE_KEY=

# --- Republic L2 ---
L2_RPC_PORT=8546
L2_BATCH_SIZE=4
DEV_MOCK_PROOF=true
REPUBLIC_NODE_URL=http://node:3000

# L1 settlement for the **prover** (optional). When all three are set, the
# prover submits RollupSettlement.submitBatch. Otherwise it writes JSON
# under the l2 volume. PRIVATE_KEY is the L2 prover key, not the Node
# L1_PUBLISHER_PRIVATE_KEY.
L1_RPC=
SETTLEMENT_ADDRESS=
PRIVATE_KEY=

# --- L2 hourly attic (S3 or Cloudflare R2). Default OFF. Hot path stays local. ---
# Object storage is the attic, not the live sequencer filesystem. Keep the last
# ARCHIVE_HOT_WINDOW_HOURS on the VPS; sealed hours older than that are uploaded
# then deleted only after checksum verify. Path-style S3 API (R2: set ENDPOINT).
ARCHIVE_ENABLED=0
ARCHIVE_S3_BUCKET=
# Empty = AWS. Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# Tests / airgap: file:///var/backups/republic-l2
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_HOT_WINDOW_HOURS=2
# Optional: copy Node l2-chain.json into the hour prefix (does not prune Node DATA_DIR).
ARCHIVE_EXPLORER_SNAPSHOT=0
ARCHIVE_INTERVAL_SECONDS=3600
# Below this free space, skip explorer snapshot / extra copies; still offload hours.
ARCHIVE_MIN_FREE_BYTES=8388608

# Node L1 tally-hash certification (optional). Unset → tally still works
# (status skipped). Never put a mainnet publisher key here in CI.
L1_TALLY_MIRROR_ADDRESS=
L1_PUBLISHER_PRIVATE_KEY=
L1_SETTLEMENT_ADDRESS=
L1_CHAIN_ID=
