# NOT FOR PROFIT — civic public good, not a commercial product.
# Copy-paste into .env (gitignored) and fill in secrets. Compose interpolates
# this file; do not put production keys in git.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Full commented block: README.md § Copy-paste credentials.
# Intentional forks pin the ONE shared ElectionFactory / BallotInbox /
# verifier. Do not run DeployLocal again for a new city. Env wins over
# /office/site. Public URLs are /admin not /admin.html.

# --- this host (Node API + SPA) ---
# Product name defaults. A name saved in Site admin > Appearance > Branding wins.
# Empty = built-in "ZK-Voting". Plain text; < > { } " ` \ are rejected.
BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_TAGLINE=
ZK_VOTING_PORT=3000
# Postgres for Node app state (accounts, passkeys, sessions, elections,
# ballots, receipts, ceremonies, plugin state, explorer chain). Set it in
# any deployment without a persistent volume. Tables are created on boot.
# Empty = JSON files in DATA_DIR (development fallback). Existing DATA_DIR
# JSON is imported once into an empty database.
# Example: postgres://zk:secret@db:5432/zkvoting?sslmode=require
DATABASE_URL=
# Chain id. Set = fixed by the environment (the first-run /setup screen shows
# it read-only). Empty = chosen on /setup (27427 civic L2, 1 Ethereum mainnet,
# 11155111 Sepolia, 31337 local, or a custom positive integer); the environment
# always wins over that stored choice. The bundled L2 sequencer reads the same
# value (compose maps it to L2_CHAIN_ID), so keep it set when you run the L2.
# Not a positive integer refuses to start.
CHAIN_ID=27427
# Inside Compose the sequencer is reachable as http://l2:8546.
# Leave empty to run the Node without a chain (local JSON store only).
CHAIN_RPC=http://l2:8546
# Public voting hostname. Empty = local demo (WebAuthn stays on localhost).
# The jurisdiction creates this DNS name and serves the Node there over HTTPS.
# That FQDN is the voting authority: passkeys, the allowed browser origin, and
# official links default to it. Bare hostname only — no scheme, port, or path.
# Example: vote.domain.tld
VOTE_FQDN=
# WebAuthn relying party id. localhost is ignored when VOTE_FQDN is set.
# Set a different public hostname only when the relying party must be a parent
# of that subdomain (same passkey on more than one host).
RP_ID=localhost
# Comma-separated browser origins. https://$VOTE_FQDN is always accepted when
# VOTE_FQDN is set, even if it is missing from this list.
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origin printed in official-outcome QR codes.
# Empty + VOTE_FQDN set → https://$VOTE_FQDN. Otherwise the first WebAuthn origin.
PUBLIC_BASE_URL=
ADMIN_HANDLE=admin
# Optional. When set, the first-run /setup screen asks for this value before it
# creates the platform super admin, and the super admin row cannot be claimed
# through plain /register. Secret: share it only with the operator.
SETUP_TOKEN=
# Setup entropy (first-run /setup steps 3-4; docs/self-hosting/first-launch.md).
# Public entropy ceremony origin, e.g. https://ceremony.zk-voting.org. Set =
# fixed by the environment (read-only on /setup). Empty = choose on /setup.
ENTROPY_CEREMONY_URL=
# SECRET. A zk-entropy string (zke1:ceremony:... from a closed ceremony, or
# zke1:local:... from `node zk-entropy/bin/zk-entropy.js generate`). Set = wins
# over the value saved on /setup. Invalid checksum refuses to start.
ZK_ENTROPY=
# Send visitors to /setup while no super admin exists (default on; off in tests).
FIRST_RUN_REDIRECT=
# Contact email for the platform super admin. Read at process start, not
# baked into the image. Empty leaves contactEmail as stored in the app.
# Invalid refuses to start. When set, the active writer applies it on every
# boot (standby does not write). /feedback delivers to this address.
SUPER_ADMIN_EMAIL=
# Disposable public demo only. Leave this unset for a real election.
# Accepted values are true, false, 1, and 0 (any case). A missing value,
# a blank value, and anything else are not a demo: the monthly soft-delete
# never runs. Set IS_DEMO=true only on the public demo instance.
# IS_DEMO=
# 3600 = hourly public vote disclosure. 0 = publish immediately (local demo).
DISCLOSURE_INTERVAL_SECONDS=3600
ALLOW_DEV_LOGIN=
ALLOW_SMART_CARD_MOCK=
ALLOW_CIVIC_ID_MOCK=

# --- AWS SES (email MFA + Terms PDF). Empty = local demo, no outbound mail.
# When FROM + REGION are set, every non-dev login completes with a 6-digit
# AWS SES code, and accepting /terms emails the current Terms PDF.
# Sign-in also emails the terms PDF and a /terms link once per member when
# the plain-text SHA-256 of /terms differs from termsNotifiedHash.
# PUBLIC_BASE_URL is the link origin. No separate terms-mail variables.
# Leave AWS keys empty to use the host IAM / instance role.
# Tests skip MFA unless REQUIRE_EMAIL_MFA=1.
SES_FROM_ADDRESS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_ENDPOINT=
SES_DRY_RUN=
REQUIRE_EMAIL_MFA=
# Public /feedback. At most one accepted submission per IP per hour.
# Values below 3600 are raised to 3600. A larger value waits longer.
# The message goes to the platform super admin contact email (or their
# sign-in email). Set SUPER_ADMIN_EMAIL above to fill that contact email
# at boot. If that person has neither, /feedback fails closed.
FEEDBACK_RATE_WINDOW_SECONDS=3600
FEEDBACK_MIN_SUBMIT_MS=3000
FEEDBACK_MAX_BODY_BYTES=16384
# Set to 1 when a reverse proxy is the TCP peer so the limit sees the client.
TRUST_PROXY=

# Optional shared secret so a later DMV / AAMVA / eID connector can
# POST /api/integrations/credentials/status. Unset = manual officer review.
CREDENTIAL_PROVIDER_SECRET=
CREDENTIAL_PROVIDER_ID=manual

# HMAC and PDF owner-password material for locked vote-receipt PDFs
# and official outcome PDFs. Unset → the Node mints a random secret and keeps
# it in Postgres (DATABASE_URL) or $DATA_DIR/receipt-pdf.secret.
RECEIPT_PDF_SECRET=

# Shared secret for L2 sequencer → Node explorer ingest. Unset in
# production refuses ingest (the explorer is not a second tally). Tests
# allow unauthenticated ingest. Set the same value on Node and l2.
EXPLORER_INGEST_SECRET=

# --- pin the ONE shared deploy (FACTORY / VERIFIER aliases). Also pin-able
# in /office/site when these are empty (platform_admin). Required with
# CHAIN_RPC unless the site pin is set. Do not deploy a new factory per city.
ELECTION_FACTORY_ADDRESS=
BALLOT_INBOX_ADDRESS=
VERIFIER_ADDRESS=
RELAYER_PRIVATE_KEY=

# --- ZK-Voting L2 ---
L2_RPC_PORT=8546
# Host interface for the published L2 RPC port (docker-compose.yml). Loopback by
# default because the sequencer RPC has no auth; use 0.0.0.0 only on purpose.
L2_RPC_BIND=127.0.0.1
L2_BATCH_SIZE=4
# Seal a block only when there is a transaction, when the disclosure hour
# closes, or once per L2_HEARTBEAT_SECONDS. Set 0 to seal every ~2s, including
# empty blocks (~43k files/day).
L2_SKIP_EMPTY_BLOCKS=1
L2_HEARTBEAT_SECONDS=3600
DEV_MOCK_PROOF=true
ZK_VOTING_NODE_URL=http://node:3000

# L1 settlement for the **prover** (optional). When L1_RPC, SETTLEMENT_ADDRESS,
# L1_CHAIN_ID, and PRIVATE_KEY are set, the lease-holding prover submits
# RollupSettlement.submitBatch. Missing address, empty code, or a chain-id
# mismatch fails closed (no submit, cursor stays). The prover never deploys.
# PRIVATE_KEY is the L2 prover key, not the Node L1_PUBLISHER_PRIVATE_KEY.
# Deploy these contracts once. See docs/ROLLING_UPDATES.md.
# FORCE_REDEPLOY=1 overrides that guard. Leave it unset on a live election.
L1_RPC=
SETTLEMENT_ADDRESS=
# The L2 operator's L1 key (SECRET). Keep only a little ETH on it: enough for
# L1_SUBMITTER_MIN_BATCHES batches. Voters never pay; the operator pays L1 gas.
# The prover warns when low and holds batches (fail closed) when it cannot pay
# for one. Check with: npm run l2:identity -- check-funding
L1_SUBMITTER_PRIVATE_KEY=
L1_SUBMITTER_MIN_BATCHES=20
L1_SUBMITTER_GAS_PER_BATCH=250000
# Legacy name for L1_SUBMITTER_PRIVATE_KEY (used only when that is empty).
PRIVATE_KEY=

# --- L2 identity and admission (voting_node/docs/L2-IDENTITY-AND-SETTLEMENT.md) ---
# Generate once with: npm run l2:identity -- init   (then `show` for L2_ID)
# l2Id = keccak256(abi.encode(domain, submitterAddress, bytes16(L2_UUID), L2_SALT))
# Election UUIDs are unique per L2; the L1 key is keccak(domain, l1ChainId, l2Id, electionUuid).
L2_UUID=
# SECRET until the L2 is registered on L1; makes the l2Id unguessable.
L2_SALT=
# Pin the derived id; the prover refuses to start on a mismatch.
L2_ID=
# Submitter address for containers that do not hold the key (Node, sequencer).
L2_OPERATOR_ADDRESS=
# SECRET shared by Node and sequencer: HMAC on operator admin txs.
L2_ADMIN_SECRET=
# strict (default in Compose) or open (local tests only).
L2_ADMISSION=strict
# Per-client write budget on the gasless RPC; 0 = off. Set when :8546 is public.
L2_WRITE_RATE_PER_MIN=0
# Node -> sequencer civic RPC for operator admin writes and L2 outcome reads.
L2_CIVIC_RPC=http://l2:8546
# Canonical L1 registry (TBD on mainnet; see the root README).
L2_REGISTRY_ADDRESS=

# --- L2 hourly attic (S3 or Cloudflare R2). Default ON. Hot path stays local. ---
# Object storage is the attic, not the live sequencer filesystem. Keep the last
# ARCHIVE_HOT_WINDOW_HOURS on the VPS; sealed hours older than that are uploaded
# then deleted only after checksum verify. Path-style S3 API (R2: set ENDPOINT).
# Default ON does not delete anything when ARCHIVE_S3_BUCKET is empty and
# ARCHIVE_S3_ENDPOINT is not a file:// sink: the job warns and exits 0.
# Set ARCHIVE_ENABLED=0 to turn the job off.
ARCHIVE_ENABLED=1
# Gzip each block and proof before upload. sha256 is over the stored bytes.
# The manifest also lists the raw sha256 and sizes. Restore gunzips.
# Older uncompressed objects (no contentEncoding) still restore as raw JSON.
ARCHIVE_COMPRESS=1
ARCHIVE_S3_BUCKET=
# Empty = AWS. Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# Tests / airgap: file:///var/backups/zk-voting-l2
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_HOT_WINDOW_HOURS=2
# Optional: copy Node l2-chain.json into the hour prefix (does not prune Node DATA_DIR).
ARCHIVE_EXPLORER_SNAPSHOT=0
ARCHIVE_INTERVAL_SECONDS=3600
# Below this free space, skip explorer snapshot / extra copies; still offload hours.
ARCHIVE_MIN_FREE_BYTES=8388608

# Node L1 tally-hash certification (optional). Unset → tally still works
# (status skipped). Never put a mainnet publisher key here in CI.
L1_TALLY_MIRROR_ADDRESS=
L1_PUBLISHER_PRIVATE_KEY=
L1_SETTLEMENT_ADDRESS=
L1_CHAIN_ID=

# --- scripts/ (start-anvil, deploy, gas economics). Optional; host-side only. ---
# Containers do not read these. See scripts/README.md. get-gas-economics.sh
# reads the L1 gas price from L1_RPC above (or GAS_GWEI).
# GAS_GWEI=
# GAS_L2_RPC=
# ETH_USD=
# PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
# PRICE_JSON_PATH=ethereum.usd
# ANVIL_PORT=8545
# ANVIL_CHAIN_ID=31337
# ANVIL_FORK_URL=
# Deploy signer: a Foundry keystore name (preferred) or a raw key. Never commit a key.
# DEPLOYER_ACCOUNT=
# DEPLOYER_PRIVATE_KEY=
# DEPLOY_RPC_URL=
# Optional writer-lease TTL in milliseconds (default 8000). Crash takeover
# waits this long. A graceful SIGTERM releases the lock immediately.
# WRITER_LEASE_TTL_MS=8000

# --- ERC-20 signal polls (phase 1). Off unless set to 1. ---
# Routes, nav, and L2 poll txs stay hidden when this is unset or 0.
POLLS_ENABLED=0
# One ERC-20 for every poll. If this is unset or not an address, polls stay
# disabled even when POLLS_ENABLED=1. The Node only reads balances on Ethereum.
# It does not send a transaction and it does not spend tokens.
# VOTING_TOKEN_ADDRESS=
# Chain of that token. Default 1 (Ethereum mainnet). Not ZK-Voting L2 (27427).
# VOTING_TOKEN_CHAIN_ID=1
# Read-only mainnet RPC for VOTING_TOKEN_CHAIN_ID. Optional second archive RPC.
# If both are set, they must agree. Never point these at a testnet.
# TOKEN_RPC_1=
# TOKEN_RPC_1_2=
# POLL_MAX_OPTIONS=32

# --- Optional: Tailscale sidecar (docker-compose.tailscale.yml only) ----------
# Ignored by docker-compose.yml. Guide: docs/self-hosting/tailscale.md
# TS_AUTHKEY=tskey-auth-...      # required by docker-compose.tailscale.yml
# TS_HOSTNAME=zk-voting          # VOTE_FQDN=<TS_HOSTNAME>.<tailnet>.ts.net
# TS_FUNNEL=false                # true publishes the site with Tailscale Funnel
