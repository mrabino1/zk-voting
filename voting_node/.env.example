# NOT FOR PROFIT — civic public good, not a commercial product.
# Copy-paste into .env (gitignored) and fill in secrets. Compose interpolates
# this file; do not put production keys in git.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Full commented block: README.md § Copy-paste credentials.
# Every Node settles civic votes on the ONE shared ZkVotingRollup contract
# (ROLLUP_ADDRESS). Do not deploy a new contract for each city.
# Public URLs are /admin not /admin.html.

# --- Postgres (required by docker compose; no password is shipped) ---
# The db service is postgres:16-alpine on the Compose network only.
# Set these yourself. DATABASE_URL must use the same role, password, and
# database, with the host name db. Percent-encode the password in the URL
# when it contains : @ / ? #. A # in any value is refused by the env file.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Example: postgres://zkvote:choose-a-long-password@db:5432/zkvote
DATABASE_URL=

# --- this host (Node API + SPA) ---
# Product name defaults. A name saved in Site admin > Appearance > Branding wins.
# Empty = built-in "ZK-Voting". Plain text; < > { } " ` \ are rejected.
BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_TAGLINE=
ZK_VOTING_PORT=3000
# Chain id. Set = fixed by the environment (the first-run /setup screen shows
# it read-only). Empty = chosen on /setup (27427 civic L2, 1 Ethereum mainnet,
# 11155111 Sepolia, 31337 local, or a custom positive integer); the environment
# always wins over that stored choice. This is the node's own chain id (poll
# signatures, wallets); the rollup's L1 chain is L1_CHAIN_ID below.
# Not a positive integer refuses to start.
CHAIN_ID=27427
# Public voting hostname. Empty = local demo (WebAuthn stays on localhost).
# The jurisdiction creates this DNS name and serves the Node there over HTTPS.
# That FQDN is the voting authority: passkeys, the allowed browser origin, and
# official links default to it. Bare hostname only — no scheme, port, or path.
# Example: vote.domain.tld
VOTE_FQDN=
# Client face. Used only when VOTE_FQDN is set. Empty fields keep the product
# name from Site admin / BRAND_NAME, the built-in mark, and a link to /.
# CLIENT_LOGO_URL and CLIENT_BRAND_URL are a site path (/logo.svg) or https URL.
# CLIENT_BRAND_SUBTITLE replaces "Office of civic elections". Empty hides that line.
# An empty CLIENT_LOGO_URL keeps /brand-mark.svg. Site admin > Branding > Header logo
# replaces either one after setup.
CLIENT_BRAND_NAME=
CLIENT_LOGO_URL=
CLIENT_BRAND_URL=
CLIENT_BRAND_SUBTITLE=
# WebAuthn relying party id. localhost is ignored when VOTE_FQDN is set.
# Set a different public hostname only when the relying party must be a parent
# of that subdomain (same passkey on more than one host).
RP_ID=localhost
# Comma-separated browser origins. https://$VOTE_FQDN is always accepted when
# VOTE_FQDN is set, even if it is missing from this list.
WEBAUTHN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origin printed in official-outcome QR codes.
# Empty + VOTE_FQDN set → https://$VOTE_FQDN. Otherwise the first WebAuthn origin.
PUBLIC_BASE_URL=
ADMIN_HANDLE=admin
# Optional. When set, the first-run /setup screen asks for this value before it
# creates the platform super admin, and the super admin row cannot be claimed
# through plain /register. Secret: share it only with the operator.
SETUP_TOKEN=
# Setup entropy (first-run /setup steps 3-4; docs/self-hosting/first-launch.md).
# Public entropy ceremony origin, e.g. https://ceremony.zk-voting.org. Set =
# fixed by the environment (read-only on /setup). Empty = choose on /setup.
ENTROPY_CEREMONY_URL=
# SECRET. A zk-entropy string (zke1:ceremony:... from a closed ceremony, or
# zke1:local:... from `node zk-entropy/bin/zk-entropy.js generate`). Set = wins
# over the value saved on /setup. Invalid checksum refuses to start.
ZK_ENTROPY=
# Send visitors to /setup while no super admin exists (default on; off in tests).
FIRST_RUN_REDIRECT=
# Contact email for the platform super admin. Read at process start, not
# baked into the image. Empty leaves contactEmail as stored in the app.
# Invalid refuses to start. When set, the active writer applies it on every
# boot (standby does not write). /feedback delivers to this address.
SUPER_ADMIN_EMAIL=
# Disposable public demo only. Leave this unset for a real election.
# Accepted values are true, false, 1, and 0 (any case). A missing value,
# a blank value, and anything else are not a demo: the monthly soft-delete
# never runs. Set IS_DEMO=true only on the public demo instance.
# IS_DEMO=
# 3600 = hourly public vote disclosure. 0 = publish immediately (local demo).
DISCLOSURE_INTERVAL_SECONDS=3600
ALLOW_DEV_LOGIN=
ALLOW_SMART_CARD_MOCK=
ALLOW_CIVIC_ID_MOCK=

# --- AWS SES (email MFA + Terms PDF). Empty = local demo, no outbound mail.
# When FROM + REGION are set, every non-dev login completes with a 6-digit
# AWS SES code, and accepting /terms emails the current Terms PDF.
# Sign-in also emails the terms PDF and a /terms link once per member when
# the plain-text SHA-256 of /terms differs from termsNotifiedHash.
# PUBLIC_BASE_URL is the link origin. No separate terms-mail variables.
# Leave AWS keys empty to use the host IAM / instance role.
# Tests skip MFA unless REQUIRE_EMAIL_MFA=1.
SES_FROM_ADDRESS=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_ENDPOINT=
SES_DRY_RUN=
REQUIRE_EMAIL_MFA=
# Public /feedback. At most one accepted submission per IP per hour.
# Values below 3600 are raised to 3600. A larger value waits longer.
# The message goes to the platform super admin contact email (or their
# sign-in email). Set SUPER_ADMIN_EMAIL above to fill that contact email
# at boot. If that person has neither, /feedback fails closed.
FEEDBACK_RATE_WINDOW_SECONDS=3600
FEEDBACK_MIN_SUBMIT_MS=3000
FEEDBACK_MAX_BODY_BYTES=16384
# Set to 1 when a reverse proxy is the TCP peer so the limit sees the client.
TRUST_PROXY=

# Optional shared secret so a later DMV / AAMVA / eID connector can
# POST /api/integrations/credentials/status. Unset = manual officer review.
CREDENTIAL_PROVIDER_SECRET=
CREDENTIAL_PROVIDER_ID=manual

# HMAC and PDF owner-password material for locked vote-receipt PDFs
# and official outcome PDFs. Unset → the Node mints a random secret and keeps
# it in Postgres (DATABASE_URL) or $DATA_DIR/receipt-pdf.secret.
RECEIPT_PDF_SECRET=


# --- Rollup: ZkVotingRollup on L1 and the L2 operator (smart-contracts/docs/ROLLUP.md) ---
# Civic votes settle on the one L1 contract; polls stay on this node.
#
# Local stack (default): the local-l1 profile runs Anvil (chain 31337) and a
# one-shot deploy that writes ROLLUP_DEPLOYMENT_FILE; node and l2 read the
# address and jurisdiction from it. The keys below are Anvil's PUBLIC dev keys
# (accounts 2 and 1): the node and operator refuse them on any other chain.
#
# Public chain: remove COMPOSE_PROFILES and ROLLUP_DEPLOYMENT_FILE, set L1_RPC,
# L1_CHAIN_ID and ROLLUP_ADDRESS to the shared deployment (tools/deploy), and
# put real keys below. Until the batch validity circuit exists, the operator
# can settle only against MockBatchVerifier, which exists only on chain 31337.
COMPOSE_PROFILES=local-l1
L1_RPC=http://l1:8545
# Optional bearer token for an L1 JSON-RPC endpoint that requires auth.
# When this is non-empty, L1 calls send Authorization: Bearer <token>.
# Empty (the default) sends no Authorization header. Never log this value.
L1_RPC_AUTH_TOKEN=
# Empty = read from ROLLUP_DEPLOYMENT_FILE, else the RPC.
L1_CHAIN_ID=
ROLLUP_ADDRESS=
ROLLUP_DEPLOYMENT_FILE=/deployments/local.json
# bytes32 jurisdiction on the rollup. Empty = from ROLLUP_DEPLOYMENT_FILE.
ROLLUP_JURISDICTION_ID=
# SECRET. The node account: the jurisdiction's clerk on L1. It publishes,
# closes and finalizes civic votes and relays guardian messages, so it needs a
# little ETH. /setup step 6 shows its balance. Voters never pay.
ROLLUP_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Seconds between the node's rollup checks (sync rolls, close after cutoff, finalize).
ROLLUP_TICK_SECONDS=15
# First L1 block of the rollup deployment. The outcomes monitor's L1 audit scans events from
# here; some RPCs refuse a log query from block 0. Empty = 0.
ROLLUP_DEPLOY_BLOCK=
# SECRET. An operator registered with setOperator. Pays L1 gas for batches.
OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# SECRET shared by node and l2: the node's bearer token for POST /v1/ballots.
# ./setup.sh mints one. Compose refuses to start without it.
L2_BALLOT_TOKEN=
L2_BATCH_SECONDS=10
# Off by default (empty or false): the operator exits if the rollup is not
# usable, the same fail-fast start as before. Set to 1 to keep the process up
# in degraded mode. /health stays HTTP 200 with status "degraded", no batches
# are submitted, and init is retried until the rollup is usable. Set this when
# the stack should stay up while L1 or the rollup is still coming online.
L2_ALLOW_DEGRADED=
# How long ballots may wait for a fuller batch. Each batch costs L1 gas. Empty = 0 on the
# local chain (seal every check), 600 elsewhere. Ballots are always sealed before a cutoff.
L2_BATCH_MAX_WAIT_SECONDS=
L2_RPC_PORT=8546
# Host interface for the published L2 port. Loopback by default; the ballot
# API needs the token, the reads are public. Use 0.0.0.0 only on purpose.
L2_RPC_BIND=127.0.0.1
# Local L1 RPC port on the host loopback (profile local-l1).
L1_RPC_PORT=8545
# Chain 31337 only: the operator accepts ballots without a zero-knowledge
# eligibility proof (the node's vote pass still gates them). Refused elsewhere.
ZK_VOTING_ALLOW_MOCK_PROOFS=1
# Optional writer-lease TTL in milliseconds (default 8000) for node rolling updates.
# WRITER_LEASE_TTL_MS=8000

# --- scripts/ (start-anvil, deploy, gas economics). Optional; host-side only. ---
# Containers do not read these. See scripts/README.md. get-gas-economics.sh
# reads the L1 gas price from L1_RPC (or GAS_GWEI). L1_RPC above is the Compose
# hostname; from the host pass --l1-rpc http://127.0.0.1:8545 instead.
# GAS_GWEI=
# GAS_L2_RPC=
# ETH_USD=
# PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
# PRICE_JSON_PATH=ethereum.usd
# ANVIL_PORT=8545
# ANVIL_CHAIN_ID=31337
# ANVIL_FORK_URL=
# Deploy signer: a Foundry keystore name (preferred) or a raw key. Never commit a key.
# DEPLOYER_ACCOUNT=
# DEPLOYER_PRIVATE_KEY=
# DEPLOY_RPC_URL=

# --- ERC-20 signal polls (phase 1). Off unless set to 1. ---
# Routes, nav, and L2 poll txs stay hidden when this is unset or 0.
POLLS_ENABLED=0
# One ERC-20 for every poll. If this is unset or not an address, polls stay
# disabled even when POLLS_ENABLED=1. The Node only reads balances on Ethereum.
# It does not send a transaction and it does not spend tokens.
# VOTING_TOKEN_ADDRESS=
# Ethereum mainnet only. Chain id 1 is the only production value. Any other
# chain id disables polls. The civic L2 (27427) is not a token chain.
# VOTING_TOKEN_CHAIN_ID=1
# First Ethereum block to scan for DelegateChanged and DelegateVotesChanged.
# Required for delegated-snapshot polls on a real RPC. Do not leave this at 0.
# VOTING_TOKEN_START_BLOCK=
# Read-only Ethereum mainnet RPC. Optional second archive RPC.
# If both are set, they must agree.
# TOKEN_RPC_1=
# TOKEN_RPC_1_2=
# POLL_MAX_OPTIONS=32

# --- Optional: Tailscale sidecar (docker-compose.tailscale.yml only) ----------
# Ignored by docker-compose.yml. Guide: docs/self-hosting/tailscale.md
# TS_AUTHKEY=tskey-auth-...      # required by docker-compose.tailscale.yml
# TS_HOSTNAME=zk-voting          # VOTE_FQDN=<TS_HOSTNAME>.<tailnet>.ts.net
# TS_FUNNEL=false                # true publishes the site with Tailscale Funnel
