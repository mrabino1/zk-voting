{
  "name": "zk-voting-node",
  "version": "0.1.0",
  "private": true,
  "description": "NOT FOR PROFIT — ZK-Voting Node (JSON API + static page host) for zk-voting.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "NODE_ENV=test ZK_VOTING_USE_MOCK_VERIFIER=1 ZK_VOTING_ALLOW_MOCK_PROOFS=1 node --test test/*.test.mjs",
    "test:a11y": "NODE_ENV=test node --test test/a11y.test.mjs",
    "certify:l1": "node scripts/certify-l1.mjs",
    "guardian": "node scripts/guardian.mjs",
    "build": "node -e \"console.log('NOT FOR PROFIT — ZK-Voting Node serves public/ and dist/; the SPA is built separately.')\""
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.864.0",
    "@noble/curves": "^1.9.7",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@zk-voting/chain-client": "0.1.0",
    "@zk-voting/proof-helpers": "file:../../packages/proof-helpers",
    "cors": "2.8.5",
    "express": "4.21.2",
    "pg": "^8.23.1",
    "snarkjs": "0.7.6",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "puppeteer-core": "^24.22.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  }
}
