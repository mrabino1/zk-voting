%% NOT FOR PROFIT — civic public good, not a commercial product.
%% ZK-Voting — informational election workflow.
%% Render: npm run docs:workflow
%% Output: docs/images/election-workflow.png
%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#e8f4fc",
    "primaryTextColor": "#061b31",
    "primaryBorderColor": "#1d4e89",
    "lineColor": "#334155",
    "secondaryColor": "#eef6e8",
    "tertiaryColor": "#fff7ed",
    "fontFamily": "ui-sans-serif, system-ui, sans-serif",
    "fontSize": "16px"
  },
  "flowchart": { "htmlLabels": true, "curve": "basis", "padding": 16, "nodeSpacing": 28, "rankSpacing": 36 }
}}%%
flowchart TB
  classDef person fill:#ede9fe,stroke:#6b21a8,color:#061b31
  classDef ballot fill:#ffedd5,stroke:#c2410c,color:#061b31
  classDef node fill:#e8f4fc,stroke:#1d4e89,color:#061b31
  classDef l2 fill:#eef6e8,stroke:#2f6b2f,color:#061b31
  classDef l1 fill:#f7efe4,stroke:#8a5a12,color:#061b31
  classDef step fill:#f8fafc,stroke:#475569,color:#061b31
  classDef join fill:#ffffff,stroke:#94a3b8,color:#334155,stroke-dasharray: 4 3

  subgraph Split["Identity is not the ballot"]
    direction LR
    Person["Person / Node login<br/>email, passkey, wallet, card, license hash<br/>the legal roll stays on the Node"]
    Gap["blind vote pass<br/>no public join key"]
    PublicBallot["Public ballot record<br/>nullifier + hiding commitment<br/>no name, no wallet, no choice"]
    Person --> Gap --> PublicBallot
  end

  subgraph Life["Civic vote lifecycle"]
    direction LR
    Publish["1 Publish<br/>createElection on L1<br/>guardians run the key ceremony"]
    Register["2 Register<br/>identity commitments<br/>through the L1 queue until the start"]
    Vote["3 Vote<br/>encrypted in the browser<br/>nullifier once, relayed by the Node<br/>batched by the L2 operator"]
    Close["4 Close<br/>L1 stores the final<br/>encrypted sum"]
    Decrypt["5 Decrypt the sum<br/>k of n guardians<br/>Withheld below minBallots"]
    Results["6 Results<br/>totals checked and<br/>certified by L1"]
    Publish --> Register --> Vote --> Close --> Decrypt --> Results
  end

  subgraph Layers["Where it runs"]
    direction LR
    Node["ZK-Voting Node<br/>clerks, voters, receipts, explorer<br/>polls: hourly disclosure and tally"]
    L2["L2 operator<br/>ballots into batches"]
    L1["Ethereum L1<br/>ZkVotingRollup, one for the world"]
    Node -->|"ballots, roll, guardian relays"| L2
    L2 -->|"batches with proofs"| L1
    Node -->|"publish, close, finalize"| L1
  end

  Split --> Life --> Layers

  class Person person
  class PublicBallot ballot
  class Gap join
  class Publish,Register,Vote,Close,Decrypt,Results step
  class Node node
  class L2 l2
  class L1 l1
