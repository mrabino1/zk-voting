{
  "name": "zk-voting",
  "private": true,
  "version": "0.1.0",
  "description": "NOT FOR PROFIT — zero-knowledge civic voting for republican democracy.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/node",
    "packages/types",
    "packages/proof-helpers",
    "packages/chain-client"
  ],
  "scripts": {
    "build": "npm run build -w apps/node",
    "test": "npm run test -w apps/node && npm run test:l2 && npm run test:proof-helpers && npm run test:contracts",
    "test:l2": "node --test l2/test/*.test.mjs",
    "test:contracts": "cd smart-contracts && forge test --via-ir",
    "test:fuzz": "cd smart-contracts && forge test --via-ir --match-path 'test/fuzz/*' --fuzz-runs 256",
    "test:invariant": "cd smart-contracts && forge test --via-ir --match-path 'test/invariant/*'",
    "test:proof-helpers": "npm test -w @zk-voting/proof-helpers",
    "circuits:status": "node circuits/scripts/proving-path.mjs status",
    "circuits:compile": "node circuits/scripts/proving-path.mjs compile",
    "circuits:setup": "node circuits/scripts/proving-path.mjs setup",
    "circuits:export": "node circuits/scripts/proving-path.mjs export",
    "circuits:prove": "node circuits/scripts/proving-path.mjs prove",
    "circuits:all": "node circuits/scripts/proving-path.mjs all",
    "circuits:test": "node circuits/scripts/proving-path.mjs test",
    "dev": "npm run dev -w apps/node",
    "l2:sequencer": "node l2/sequencer/index.mjs",
    "l2:prover": "node l2/prover/index.mjs",
    "start": "npm run start -w apps/node"
  },
  "engines": {
    "node": ">=22"
  }
}
