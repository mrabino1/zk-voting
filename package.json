{
  "name": "zk-voting",
  "private": true,
  "version": "0.1.0",
  "description": "NOT FOR PROFIT — zero-knowledge civic voting for republican democracy.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/node",
    "packages/types",
    "packages/proof-helpers",
    "packages/chain-client"
  ],
  "scripts": {
    "build": "npm run build -w apps/node",
    "test": "npm run test:node && npm run test:packages && npm run test:l2 && npm run test:contracts && npm run test:auditor && npm run test:docs",
    "test:node": "npm run test -w apps/node",
    "test:packages": "npm test -w @zk-voting/chain-client && npm test -w @zk-voting/proof-helpers",
    "certify:l1": "node apps/node/scripts/certify-l1.mjs",
    "test:l2": "node --test l2/test/*.test.mjs",
    "test:contracts": "cd smart-contracts && forge test --via-ir",
    "test:fuzz": "cd smart-contracts && forge test --via-ir --match-path 'test/fuzz/*' --fuzz-runs 256",
    "test:invariant": "cd smart-contracts && forge test --via-ir --match-path 'test/invariant/*'",
    "test:auditor": "node --test tools/auditor/*.test.mjs",
    "test:docs": "node --test docs/diagrams/*.test.mjs",
    "docs:workflow": "node docs/diagrams/render.mjs",
    "auditor": "node tools/auditor/cli.mjs",
    "test:proof-helpers": "npm test -w @zk-voting/proof-helpers",
    "circuits:status": "node circuits/scripts/proving-path.mjs status",
    "circuits:compile": "node circuits/scripts/proving-path.mjs compile",
    "circuits:setup": "node circuits/scripts/proving-path.mjs setup",
    "circuits:export": "node circuits/scripts/proving-path.mjs export",
    "circuits:prove": "node circuits/scripts/proving-path.mjs prove",
    "circuits:smoke": "node circuits/scripts/proving-path.mjs smoke",
    "circuits:verify": "node circuits/scripts/proving-path.mjs verify",
    "circuits:all": "node circuits/scripts/proving-path.mjs all",
    "circuits:test": "node circuits/scripts/proving-path.mjs test",
    "circuits:ceremony": "node circuits/scripts/ceremony.mjs",
    "circuits:ceremony:toy": "node --test circuits/scripts/ceremony.test.mjs",
    "dev": "npm run dev -w apps/node",
    "l2:sequencer": "node l2/sequencer/index.mjs",
    "l2:prover": "node l2/prover/index.mjs",
    "l2:archive": "node l2/archive/cli.mjs archive",
    "l2:archive:restore": "node l2/archive/cli.mjs restore",
    "l2:archive:daemon": "node l2/archive/cli.mjs daemon",
    "start": "npm run start -w apps/node",
    "load:local": "node tools/load/harness.mjs",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=80",
    "compose:ps": "docker compose ps"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "snarkjs": "^0.7.6"
  }
}
